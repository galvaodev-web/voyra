NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The hosted application must keep the demo disabled. GitHub Pages has its own static build.
NEXT_PUBLIC_DEMO_ENABLED=false
# Set to .voyra.com on BOTH Travel and Social only after deploying HTTPS subdomains.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Enable Google only after configuring and testing its Supabase provider.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Free accounts can launch independently. Enable paid checkout after Stripe validation.
NEXT_PUBLIC_BILLING_ENABLED=false
# Canonical origin, including protocol; no trailing path.
SITE_URL=http://localhost:3000
# Public Social origin used by Token links.
NEXT_PUBLIC_SOCIAL_URL=http://localhost:3001
# Server-only Supabase administrative key (never NEXT_PUBLIC).
SUPABASE_SERVICE_ROLE_KEY=
# Stripe: start in test mode. Prices must be monthly BRL: Plus 2490, Creator 4990 cents.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_CREATOR=
# Skyscanner Affiliate/Impact media partner identifier. Required to monetize referral traffic.
SKYSCANNER_MEDIA_PARTNER_ID=
# Protects the scheduled storage-cleanup endpoint. Generate at least 32 random bytes.
CRON_SECRET=
# Optional email delivery for price alerts. In-app alerts work without these.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
# Optional server-only Sentry DSN. Only safe operational metadata is sent.
SENTRY_DSN=
# Optional consent-gated product analytics.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# HMAC secret used to pseudonymize rate-limit identifiers. Generate at least 32 random bytes.
RATE_LIMIT_SECRET=
# Explicit offline references used only when the exchange provider is unavailable.
EXCHANGE_FALLBACK_EUR_BRL=6
EXCHANGE_FALLBACK_USD_BRL=5.2
# Published policies and support provided by the operator before public launch.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional public promotional URL issued by Booking.com/CJ after approval.
# Keep the full tracking URL unchanged. Empty = ordinary Booking.com link, no commission.
NEXT_PUBLIC_BOOKING_AFFILIATE_URL=
# Server-side AI provider used by Voyra AI and free-text translation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Server-side Mapbox token used for Search Box and Static Images APIs.
MAPBOX_ACCESS_TOKEN=
# WeatherAPI.com server key. Never prefix provider credentials with NEXT_PUBLIC.
WEATHER_API_KEY=
