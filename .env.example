NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Demo is available only while Supabase is not configured.
# Set false to disable it even without Supabase.
NEXT_PUBLIC_DEMO_ENABLED=true
# Canonical origin, including protocol; no trailing path.
SITE_URL=http://localhost:3000
# Server-only Supabase administrative key (never NEXT_PUBLIC).
SUPABASE_SERVICE_ROLE_KEY=
# Stripe: start in test mode. Prices must be monthly BRL: Plus 2490, Creator 4990 cents.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_CREATOR=
# Skyscanner Affiliate/Impact media partner identifier. Required to monetize referral traffic.
SKYSCANNER_MEDIA_PARTNER_ID=
# Protects the scheduled storage-cleanup endpoint. Generate at least 32 random bytes.
CRON_SECRET=
# Published policies and support provided by the operator before public launch.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional providers below are not called; these features remain labeled demonstrations.
OPENAI_API_KEY=
MAPBOX_ACCESS_TOKEN=
WEATHER_API_KEY=
