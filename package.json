{
  "name": "voyra",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:pages": "vite build --config preview/vite.config.mts",
    "preview:pages": "vite preview --config preview/vite.config.mts",
    "test:pages": "playwright test --config preview/playwright.config.ts",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:unit": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:db": "tsx scripts/check-schema.ts",
    "test:billing": "node --conditions=react-server --import tsx scripts/check-billing.ts",
    "check:launch": "tsx scripts/check-launch.ts",
    "build:launch": "npm run check:launch && next build",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.49.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  }
}
